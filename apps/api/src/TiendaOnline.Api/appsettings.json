{
  "App": {
    "Name": "TiendaOnline.Api",
    "Version": "1.0.0"
  },
  "Auth": {
    "Issuer": "TiendaOnline.Api",
    "Audience": "TiendaOnline.Clients",
    "SecretKey": "",
    "TokenExpirationMinutes": 60
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=tienda_online;Username=tienda_online;Password=tienda_online_local",
    "UseInMemoryForTesting": false,
    "InMemoryDatabaseName": "tienda-online-tests",
    "ApplySqlMigrationsOnStartup": false,
    "SeedDevelopmentData": false
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
